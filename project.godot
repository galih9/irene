; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="All You Can Merge"
config/description="A fun simple non hyper microtransaction play merging game"
config/version="1.0.8"
run/main_scene="res://scenes/splash_screen.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.94509804, 0.40784314, 0.08235294, 1)
boot_splash/show_image=false
boot_splash/stretch_mode=2
boot_splash/image="uid://d03k2q3ae4iga"

[autoload]

OrientationManager="*res://scripts/autoload/orientation_manager.gd"
GameEvents="*res://scripts/autoload/game_events.gd"
ItemDatabase="*res://scripts/autoload/item_database.gd"
EconomyManager="*res://scripts/autoload/economy_manager.gd"
SoundManager="*res://scripts/autoload/sound_manager.gd"
ProgressionManager="*res://scripts/autoload/progression_manager.gd"
InventoryManager="*res://scripts/autoload/inventory_manager.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
CursorManager="*res://scripts/autoload/cursor_manager.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1600
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
mouse_cursor/custom_image="res://assets/cursor/pointer_a.png"
mouse_cursor/custom_image_hotspot=Vector2(10, 6)

[gui]

theme/custom="res://resources/cozy_theme.tres"
theme/custom_font="res://assets/fons/gotham.otf"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.12, 0.14, 0.18, 1)
